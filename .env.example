# Copy to .env and fill in. .env is gitignored.
# All variables are optional; with none set, the API runs the deterministic
# zero-cost mock provider.

# --- Upstream selection ---------------------------------------------------
# mock | opencode-cli | openrouter
# If unset but OPENROUTER_API_KEY is present, openrouter is used; else mock.
MOM_UPSTREAM=openrouter

# --- OpenRouter upstream --------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://mixtureofmodels.com
# OPENROUTER_APP_TITLE=Mixture of Models

# --- Internal architecture model roles ------------------------------------
MOM_PROPOSER_MODELS=deepseek/deepseek-v4-flash,xiaomi/mimo-v2.5,minimax/minimax-m3
MOM_REFUTER_MODEL=deepseek/deepseek-v4-flash
MOM_SYNTHESIZER_MODEL=minimax/minimax-m3
MOM_PROVIDER_TIMEOUT_SECONDS=180

# --- Public API auth (optional) -------------------------------------------
# Comma-separated bearer keys clients must present. Leave empty to disable auth.
MOM_API_KEYS=
